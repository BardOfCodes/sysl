{% extends "base.html.j2" %}
{% block content %}

<div class="w-full min-h-screen">
  <!-- Interactive Shader Visualizer -->
  <div class="w-full h-full bg-white">
    <div class="w-full h-full {% if layout_horizontal %}flex flex-row gap-6 p-4{% else %}space-y-6 p-4{% endif %}">
      
      <!-- Canvas Area -->
      <div class="{% if layout_horizontal %}flex-shrink-0{% else %}flex justify-center{% endif %}">
        <div id="canvas-container" class="relative bg-black rounded-lg overflow-hidden shadow-lg" style="width: 512px; height: 512px;">
          <canvas
            id="glcanvas"
            class="absolute inset-0 w-full h-full"
          ></canvas>
        </div>
      </div>

      <!-- Controls Area -->
      <div class="{% if layout_horizontal %}flex-1 {% if not allow_overflow %}h-[512px] overflow-y-auto{% endif %}{% else %}w-full{% endif %}">
        {% include "controls.html.j2" %}
      </div>
      
    </div>
  </div>
</div>

<!-- Include Script Component Based on Backend -->
{% if backend == 'twgl' %}
{% include "twgl_script.js.html.j2" %}
{% else %}
{% include "regl_script.js.html.j2" %}
{% endif %}

{% endblock %} 