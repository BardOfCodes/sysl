// --- Inline TWGL Texture Loader (supports 2D + 3D, float32 + float16) ---
import * as pako from 'https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.esm.mjs';

// === Convert Float32Array to Uint16Array (half-float encoding) ===
function float32ToFloat16Array(f32) {
  const f16 = new Uint16Array(f32.length);
  for (let i = 0; i < f32.length; i++) {
    const x = f32[i];
    const floatView = new Float32Array(1);
    const intView = new Uint32Array(floatView.buffer);
    floatView[0] = x;
    const f = intView[0];

    const sign = (f >> 31) & 0x1;
    const exp = ((f >> 23) & 0xff) - 127;
    const frac = f & 0x7fffff;

    let hf;
    if (exp < -14) {
      hf = 0;  // too small, zero
    } else if (exp > 15) {
      hf = (sign << 15) | (0x1f << 10); // Inf
    } else {
      const new_exp = exp + 15;
      const new_frac = frac >> 13;
      hf = (sign << 15) | (new_exp << 10) | new_frac;
    }

    f16[i] = hf;
  }
  return f16;
}

function parseBase64AndDecompress(base64Str, dtype = "float32", descriptor = null) {
  const binaryStr = atob(base64Str);
  const byteArray = Uint8Array.from(binaryStr, c => c.charCodeAt(0));
  const decompressed = pako.inflate(byteArray).buffer;

  if (descriptor && descriptor.shape) {
    const [C, D, H, W] = descriptor.shape;
    const expectedLen = C * D * H * W;
    const byteLen = dtype === "float16" ? expectedLen * 2 : expectedLen * 4;
    if (decompressed.byteLength !== byteLen) {
      console.warn(`⚠️ Expected ${byteLen} bytes but got ${decompressed.byteLength}`);
    }
  }

  if (dtype === "float32") {
    return new Float32Array(decompressed);
  } else if (dtype === "float16") {
    return new Uint16Array(decompressed);  // ✅ Correct: raw fp16 bytes
  } else {
    throw new Error(`Unsupported dtype '${dtype}'`);
  }
}
function createTextureFromDescriptor(gl, descriptor) {
  const { name, shape, n_dim, dtype = "float32", data_b64 } = descriptor;
  const [D1, D2, D3 = 1] = shape.slice(-3);
  const data = parseBase64AndDecompress(data_b64, dtype);
  const texelCount = D1 * D2 * D3;

  if (data.length !== texelCount) {
    console.warn(`⚠️ Texture '${name}' has unexpected length: expected ${texelCount}, got ${data.length}`);
  }

  // Check for extensions
  const extHalfFloat = gl.getExtension("OES_texture_half_float");
  const extLinearHalf = gl.getExtension("OES_texture_half_float_linear");
  const extColorBufferHalf = gl.getExtension("EXT_color_buffer_half_float");

  const format = gl.RED;
  let internalFormat, type, filter;

  if (dtype === "float32") {
    internalFormat = gl.R32F;
    type = gl.FLOAT;
    filter = gl.getExtension('OES_texture_float_linear') ? gl.LINEAR : gl.NEAREST;
  } else if (dtype === "float16") {
    if (!extHalfFloat || !extColorBufferHalf) {
      throw new Error("Half-float not supported by this browser / GPU");
    }
    internalFormat = gl.R16F;
    type = extHalfFloat.HALF_FLOAT_OES;
    filter = extLinearHalf ? gl.LINEAR : gl.NEAREST;
  } else {
    throw new Error(`Unsupported dtype '${dtype}'`);
  }

  const tex = gl.createTexture();
  if (!tex) throw new Error(`Failed to create texture '${name}'`);

  const target = (n_dim === 3) ? gl.TEXTURE_3D : gl.TEXTURE_2D;
  gl.bindTexture(target, tex);

  if (n_dim === 3) {
    gl.texImage3D(target, 0, internalFormat, D3, D2, D1, 0, format, type, data);
    gl.texParameteri(target, gl.TEXTURE_MIN_FILTER, filter);
    gl.texParameteri(target, gl.TEXTURE_MAG_FILTER, filter);
    gl.texParameteri(target, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(target, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(target, gl.TEXTURE_WRAP_R, gl.CLAMP_TO_EDGE);
  } else if (n_dim === 2) {
    gl.texImage2D(target, 0, internalFormat, D2, D1, 0, format, type, data);
    gl.texParameteri(target, gl.TEXTURE_MIN_FILTER, filter);
    gl.texParameteri(target, gl.TEXTURE_MAG_FILTER, filter);
    gl.texParameteri(target, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(target, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  } else {
    throw new Error(`Unsupported texture dimension '${n_dim}'`);
  }

  gl.bindTexture(target, null);
  return tex;
}

async function loadTextures(gl, textureRegistry) {
  console.log("🎨 Loading textures...");
  const result = {};
  for (const [texName, descriptor] of Object.entries(textureRegistry)) {
    try {
      const tex = createTextureFromDescriptor(gl, descriptor);
      result[texName] = tex;
      console.log(`✅ Loaded texture '${texName}'`);
    } catch (err) {
      console.error(`❌ Error loading texture '${texName}':`, err);
    }
  }
  return result;
}