// --- Inline TWGL Texture Loader (supports 2D + 3D, float32, int32, uint8, single/RGB/RGBA) ---
import * as pako from 'https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.esm.mjs';

async function parseBase64AndDecompress(base64Str, dtype) {
  const binaryStr = atob(base64Str);
  const byteArray = Uint8Array.from(binaryStr, c => c.charCodeAt(0));
  
  // Yield control for large data to prevent blocking
  if (byteArray.length > 1024 * 1024) { // 1MB threshold
    await new Promise(resolve => setTimeout(resolve, 0));
  }
  
  const decompressed = pako.inflate(byteArray).buffer;
  
  switch(dtype) {
    case 'float32': return new Float32Array(decompressed);
    case 'int32': return new Int32Array(decompressed);
    case 'uint8': return new Uint8Array(decompressed);
    default: throw new Error(`Unsupported dtype: ${dtype}`);
  }
}

async function createTextureFromDescriptor(gl, descriptor) {
  const { name, shape, dtype = "float32", data_b64 } = descriptor;
  
  // Extract channels and spatial dimensions
  // Format: [H, W, C] or [H, W, D, C] - channels last
  const numChannels = shape[shape.length - 1];
  const spatialDims = shape.slice(0, -1);
  const n_dim = spatialDims.length;
  
  if (![1, 2, 3, 4].includes(numChannels)) {
    throw new Error(`Unsupported channel count: ${numChannels}. Supported: 1, 2, 3, 4`);
  }
  
  // Parse and decompress data (already in interleaved format)
  const data = await parseBase64AndDecompress(data_b64, dtype);
  
  // Debug: Print basic data statistics
  // Use efficient min/max calculation for large arrays to avoid stack overflow
  
  console.log(`📊 Texture '${name}' (${dtype}, ${numChannels}ch, ${n_dim}D):`);
  console.log(`   📏 Data size: ${data.length} elements`);
  {# console.log(`   📈 Value range: [${dataMin}, ${dataMax}]`); #}
  console.log(`   🎯 Shape: [${shape.join(', ')}]`);
  
  // Validate data size
  const expectedElements = spatialDims.reduce((a, b) => a * b, 1) * numChannels;
  if (data.length !== expectedElements) {
    console.warn(`⚠️ Texture '${name}': expected ${expectedElements} elements, got ${data.length}`);
  }
  
  // Get WebGL parameters based on data type and channels
  const isWebGL2 = gl.getParameter(gl.VERSION).includes("WebGL 2.0");
  let internalFormat, format, type, filter;
  
  if (dtype === 'float32') {
    // Check float texture support
    if (!isWebGL2 && !gl.getExtension('OES_texture_float')) {
      throw new Error('Float textures not supported - missing OES_texture_float extension');
    }
    
    if (isWebGL2) {
      const formats = [gl.R32F, gl.RG32F, gl.RGB32F, gl.RGBA32F];
      const formatTypes = [gl.RED, gl.RG, gl.RGB, gl.RGBA];
      const index = numChannels === 1 ? 0 : numChannels === 2 ? 1 : numChannels === 3 ? 2 : 3;
      internalFormat = formats[index];
      format = formatTypes[index];
    } else {
      const formats = [gl.LUMINANCE, gl.LUMINANCE_ALPHA, gl.RGB, gl.RGBA];
      const index = numChannels === 1 ? 0 : numChannels === 2 ? 1 : numChannels === 3 ? 2 : 3;
      internalFormat = format = formats[index];
    }
    type = gl.FLOAT;
    filter = gl.getExtension('OES_texture_float_linear') ? gl.LINEAR : gl.NEAREST;
    
  } else if (dtype === 'int32') {
    if (!isWebGL2) {
      throw new Error('Integer textures require WebGL 2.0');
    }
    const intFormats = [gl.R32I, gl.RG32I, gl.RGB32I, gl.RGBA32I];
    const intFormatTypes = [gl.RED_INTEGER, gl.RG_INTEGER, gl.RGB_INTEGER, gl.RGBA_INTEGER];
    const index = numChannels === 1 ? 0 : numChannels === 2 ? 1 : numChannels === 3 ? 2 : 3;
    internalFormat = intFormats[index];
    format = intFormatTypes[index];
    type = gl.INT;
    filter = gl.NEAREST;
    
  } else if (dtype === 'uint8') {
    // Check WebGL2 requirement for 3D textures
    if (n_dim === 3 && !isWebGL2) {
      throw new Error('3D uint8 textures require WebGL 2.0');
    }
    
    if (isWebGL2) {
      // For single/dual channel textures in WebGL2, ensure support
      if (numChannels <= 2) {
        const redSupport = gl.getParameter(gl.MAX_TEXTURE_SIZE) > 0; // Basic check
        console.log(`🔍 WebGL2 ${numChannels}-channel uint8 texture support check: ${redSupport}`);
      }
      
      // WebGL2 format mapping: 1=R8, 2=RG8, 3=RGB8, 4=RGBA8
      const formatMap = {
        1: { internal: gl.R8, format: gl.RED },
        2: { internal: gl.RG8, format: gl.RG },
        3: { internal: gl.RGB8, format: gl.RGB },
        4: { internal: gl.RGBA8, format: gl.RGBA }
      };
      internalFormat = formatMap[numChannels].internal;
      format = formatMap[numChannels].format;
    } else {
      // WebGL1 fallback - check if we have necessary extensions
      if (numChannels <= 2) {
        console.log(`⚠️  WebGL1 ${numChannels}-channel uint8 - using ${numChannels === 1 ? 'LUMINANCE' : 'LUMINANCE_ALPHA'} format`);
      }
      
      // WebGL1 format mapping: 1=LUMINANCE, 2=LUMINANCE_ALPHA, 3=RGB, 4=RGBA
      const formatMap = {
        1: gl.LUMINANCE,
        2: gl.LUMINANCE_ALPHA,
        3: gl.RGB,
        4: gl.RGBA
      };
      internalFormat = format = formatMap[numChannels];
    }
    type = gl.UNSIGNED_BYTE;
    filter = gl.LINEAR;
  } else {
    throw new Error(`Unsupported dtype: ${dtype}`);
  }
  
  // Debug: Print WebGL format information
  console.log(`🔧 WebGL formats for '${name}':`);
  console.log(`   📝 Internal: 0x${internalFormat.toString(16)} (${internalFormat})`);
  console.log(`   📝 Format: 0x${format.toString(16)} (${format})`);
  console.log(`   📝 Type: 0x${type.toString(16)} (${type})`);
  console.log(`   🎛️  Filter: 0x${filter.toString(16)} (${filter})`);
  console.log(`   🌐 WebGL2: ${isWebGL2}`);
  
  // Create texture
  const tex = gl.createTexture();
  if (!tex) throw new Error(`Failed to create texture '${name}'`);
  
  const target = (n_dim === 3) ? gl.TEXTURE_3D : gl.TEXTURE_2D;
  gl.bindTexture(target, tex);
  
  gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);  // 👈🏽 This line is essential for single-channel uint8

  // Set texture parameters
  gl.texParameteri(target, gl.TEXTURE_MIN_FILTER, filter);
  gl.texParameteri(target, gl.TEXTURE_MAG_FILTER, filter);
  gl.texParameteri(target, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(target, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  
  if (n_dim === 3) {
    const [depth, height, width] = spatialDims;
    gl.texParameteri(target, gl.TEXTURE_WRAP_R, gl.CLAMP_TO_EDGE);
    gl.texImage3D(target, 0, internalFormat, width, height, depth, 0, format, type, data);
  } else if (n_dim === 2) {
    const [height, width] = spatialDims;
    gl.texImage2D(target, 0, internalFormat, width, height, 0, format, type, data);
  } else {
    throw new Error(`Unsupported dimensions: ${n_dim}. Only 2D and 3D textures supported`);
  }
  
  gl.bindTexture(target, null);
  
  // Debug: Check for WebGL errors after texture creation
  const error = gl.getError();
  if (error !== gl.NO_ERROR) {
    console.error(`❌ WebGL error after creating texture '${name}': 0x${error.toString(16)}`);
  } else {
    console.log(`✅ Successfully created texture '${name}' (${target === gl.TEXTURE_3D ? '3D' : '2D'})`);
  }
  
  return tex;
}

async function loadTextures(gl, textureRegistry) {
  console.log("🎨 Loading textures...");
  const result = {};
  
  for (const [texName, descriptor] of Object.entries(textureRegistry)) {
    try {
      const tex = await createTextureFromDescriptor(gl, descriptor);
      result[texName] = tex;
      console.log(`✅ Loaded '${texName}'`);
      
      // Yield control between texture loads to prevent blocking
      await new Promise(resolve => setTimeout(resolve, 0));
    } catch (err) {
      console.error(`❌ Failed to load texture '${texName}':`, err.message);
    }
  }
  
  return result;
}

// === Main exports ===
// loadTextures(gl, textureRegistry) - Load all textures from registry
// createTextureFromDescriptor(gl, descriptor) - Create single texture from descriptor